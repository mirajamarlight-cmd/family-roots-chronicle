# Coolify: set these as environment variables (not committed).
# Mark the VITE_* ones as available at build time.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Family assistant (server-only; never expose to the client)
# Groq (recommended if you have a Groq key — OpenAI-compatible API)

# Or OpenAI instead
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
