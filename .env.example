# Coolify: set these as environment variables (not committed).
# Mark the VITE_* ones as available at build time.

# --- Dual-run migration (default remains Supabase) ---
# DATA_BACKEND=supabase|postgres
DATA_BACKEND=supabase
# Standard Postgres (required when DATA_BACKEND=postgres)
DATABASE_URL=postgres://frc_app:CHANGE_ME@127.0.0.1:5432/family_roots
# Optional elevated URL for migrations / backup load
DATABASE_MIGRATE_URL=postgres://frc_migrate:CHANGE_ME@127.0.0.1:5432/family_roots
SESSION_SECRET=replace-with-long-random-string
APP_ORIGIN=https://babafeqi.raafat.site

# --- Existing Supabase (keep until cutover) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Family assistant (server-only; never expose to the client)
# First matching key wins: Gemini, then Groq, then OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
# llama-3.3-70b-versatile was retired 2026-08-16; use openai/gpt-oss-120b or qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# Or OpenAI instead
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
